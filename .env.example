# ---------------------------------------------------------
# Fase 1 - Fundacao. Copie para .env e ajuste os valores.
# ---------------------------------------------------------
NODE_ENV=development
PORT=3333

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://hospital_user:hospital_pass@localhost:5432/hospital_platform?schema=public"

# JWT - autenticacao local (Fase 1)
JWT_ACCESS_SECRET=troque-esta-chave-em-producao-access
JWT_REFRESH_SECRET=troque-esta-chave-em-producao-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Politica de senha local
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------------
# Provedor de autenticacao ativo: local | ldap | oidc (SSO)
# A troca deste valor ativa outra estrategia sem alterar o core.
# --------------------------------------------------------------
AUTH_PROVIDER=local

# Reservado para Fase futura (AD/LDAP) - nao usado na Fase 1
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# Reservado para Fase futura (SSO / OIDC) - nao usado na Fase 1
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Reservado para Fase futura (MFA) - nao usado na Fase 1
MFA_ENABLED=false
